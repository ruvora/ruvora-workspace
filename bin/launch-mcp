#!/bin/sh
set -eu
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${CODEX_MCP_NODE_PATH:-}" ]; then
  node_bin=$CODEX_MCP_NODE_PATH
elif command -v node >/dev/null 2>&1; then
  node_bin=$(command -v node)
elif [ -x /Users/sin-yebin/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node ]; then
  node_bin=/Users/sin-yebin/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node
else
  echo 'Node >=24 required; set CODEX_MCP_NODE_PATH.' >&2
  exit 1
fi
exec "$node_bin" "$plugin_root/bin/workspace.mjs" mcp
